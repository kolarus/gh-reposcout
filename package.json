{
  "name": "reposcout",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only --appIdSuffix debug",
    "android:release": "react-native run-android --mode release --active-arch-only",
    "ios": "react-native run-ios",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "start": "react-native start",
    "check:node": "node -e \"const [major, minor] = process.versions.node.split('.').map(Number); if (major < 22 || (major === 22 && minor < 18)) { console.error('Node ' + process.version + ' is too old: repo scripts are TypeScript run by Node (needs >= 22.18). Run nvm use (.nvmrc pins 24).'); process.exit(1); }\"",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:scripts": "node --test \"scripts/**/*.test.mts\"",
    "check:architecture": "node scripts/check-architecture.mts",
    "check:docs": "node scripts/check-docs.mts",
    "check:version": "node scripts/check-version.mts",
    "check:bundle": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output node_modules/.cache/bundle-check/android.js --reset-cache && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output node_modules/.cache/bundle-check/ios.js",
    "knip": "knip",
    "arch:graph": "node scripts/arch-graph.mts",
    "brand:generate": "node scripts/generate-brand-assets.mts",
    "e2e:setup": "bash scripts/e2e/setup-devices.sh",
    "e2e:android": "bash scripts/e2e/run.sh android",
    "e2e:ios": "bash scripts/e2e/run.sh ios",
    "e2e:record": "bash scripts/e2e/run.sh --record",
    "perf:android": "bash scripts/perf/android.sh",
    "media:android": "bash scripts/media/android.sh",
    "release:prepare": "node scripts/sync-version.mts",
    "validate": "yarn check:node && yarn typecheck && yarn lint && yarn format:check && yarn check:architecture && yarn check:docs && yarn check:version && yarn check:bundle && yarn knip && yarn test:scripts && yarn test",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/octicons": "21.1.4",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "5.103.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-bootsplash": "7.3.3",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-dynamic-import": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@tanstack/eslint-plugin-query": "5.103.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
