/** A one-colour Android resources file. */
export const colorResourceXml = (name: string, hex: string): string =>
  `<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by yarn brand:generate (ADR-0023). -->
<resources>
    <color name="${name}">${hex}</color>
</resources>
`;

const component = (hex: string, offset: number): string =>
  (parseInt(hex.slice(offset, offset + 2), 16) / 255).toFixed(3);

const srgb = (hex: string) => ({
  'color-space': 'srgb',
  components: {
    red: component(hex, 1),
    green: component(hex, 3),
    blue: component(hex, 5),
    alpha: '1.000',
  },
});

const hasAppearance = (entry: unknown): boolean =>
  typeof entry === 'object' && entry !== null && 'appearances' in entry;

/**
 * An asset-catalog colour set (its parsed Contents.json) with a dark variant
 * added, replacing any earlier one. bootsplash writes the light colour; its
 * dark-mode generation needs a paid licence (ADR-0010).
 */
export function withDarkVariant(contents: object, darkHex: string): object {
  const colors: readonly unknown[] =
    'colors' in contents && Array.isArray(contents.colors)
      ? contents.colors
      : [];
  return {
    ...contents,
    colors: [
      ...colors.filter(entry => !hasAppearance(entry)),
      {
        appearances: [{ appearance: 'luminosity', value: 'dark' }],
        color: srgb(darkHex),
        idiom: 'universal',
      },
    ],
  };
}

