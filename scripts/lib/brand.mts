const DEEP_LINK_COMMENT =
  '<!-- Deep links: reposcout://repo/{owner}/{name} (ADR-0006) -->';

/**
 * bootsplash reformats AndroidManifest.xml and drops its comments; this puts
 * the deep-link note back above the VIEW intent filter (idempotent).
 */
export function restoreManifestComments(manifest: string): string {
  if (manifest.includes(DEEP_LINK_COMMENT)) return manifest;
  return manifest.replace(
    /^([ \t]*)(<intent-filter>\s*<action android:name="android\.intent\.action\.VIEW")/m,
    `$1${DEEP_LINK_COMMENT}\n$1$2`,
  );
}
