/**
 * Pure helpers for `yarn brand:generate` (ADR-0023): where each icon goes,
 * at what size, and the small native files around them.
 */

/** Android densities and their scale factor against mdpi (1 dp = 1 px). */
export const ANDROID_DENSITIES = [
  { name: 'mdpi', scale: 1 },
  { name: 'hdpi', scale: 1.5 },
  { name: 'xhdpi', scale: 2 },
  { name: 'xxhdpi', scale: 3 },
  { name: 'xxxhdpi', scale: 4 },
] as const;

/** Legacy launcher icon (Android 7 and older): 48 dp. */
export const LEGACY_ICON_DP = 48;
/** Adaptive icon layers: 108 dp, of which a 66 dp circle is always visible. */
export const ADAPTIVE_LAYER_DP = 108;
/**
 * The emblem's share of an adaptive layer: its badge (97% of the SVG box)
 * then fills the 66 dp safe circle, so no launcher mask cuts it.
 */
export const ADAPTIVE_EMBLEM_SHARE = 0.63;
/** The emblem's share of the iOS icon square, inside the rounded-rect mask. */
export const IOS_EMBLEM_SHARE = 0.86;

/**
 * Hex colours from the design tokens (`src/shared/theme/tokens.ts`), read as
 * text so the scripts don't compile app code. The lookup throws on an unknown
 * name, so a renamed token fails loudly instead of producing a wrong colour.
 */
export function readPalette(tokensSource: string): (name: string) => string {
  const palette = new Map<string, string>();
  for (const [, name, hex] of tokensSource.matchAll(
    /(\w+): '(#[0-9A-Fa-f]{6})'/g,
  )) {
    if (name !== undefined && hex !== undefined) palette.set(name, hex);
  }
  return name => {
    const hex = palette.get(name);
    if (hex === undefined) throw new Error(`Palette entry not found: ${name}`);
    return hex;
  };
}

/** Android adaptive icon: brand background, emblem foreground, themed-icon layer. */
export const adaptiveIconXml = `<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by yarn brand:generate (ADR-0023). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
